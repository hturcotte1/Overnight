{
  "name": "overnight",
  "version": "0.0.0",
  "private": true,
  "description": "Say it at lunch. Use it at breakfast. Overnight hears app ideas through Bee, asks on the wrist, and has Kiro build them while you sleep.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@beeai/cli": "0.7.3",
    "better-sqlite3": "13.0.3",
    "zod": "4.6.5"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "eval:detector": "node packages/detector/src/eval.ts",
    "overnight": "node packages/cli/src/main.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
