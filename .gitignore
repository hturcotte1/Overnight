# Dependencies and build output
node_modules/
dist/
coverage/
playwright-report/
test-results/

# Secrets. Only .env.example is committed.
.env
.env.*
!.env.example

# Bee data, transcripts, screenshots and databases never go in the repo.
# Overnight keeps them in ~/.overnight; these lines are a second safety net.
.overnight/
*.db
*.db-*
*.sqlite
*.jsonl
spikes/out/
screenshots/

# Local noise
.DS_Store
*.log
.claude/settings.local.json

submission/*.webm
submission/frames/
# The launch film: the finished MP4 (over GitHub's 100 MB limit), rendered frames, the real dashboard
# and app captures (real screenshots), the rendered score, compiled tools and review stills.
submission/*.mp4
submission/film/frames/
submission/film/capture/
submission/film/audio/
submission/film/.build/
submission/film/review/
submission/devpost-paste.txt
submission/agent-prompt.txt
