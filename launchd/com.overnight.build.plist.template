<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Overnight's nightly build, as a macOS background job (a "LaunchAgent"). Every minute it runs
  `overnight build` with the if-due switch: Overnight looks at its own clock, and at BUILD_TIME
  each approved idea is built, one at a time. At every other minute it ends at once.
  This is a template: scripts/install-agents.sh replaces the names written in capitals between
  double underscores with real values, and puts the result in
  ~/Library/LaunchAgents/com.overnight.build.plist. Do not install this file by hand.

  Background jobs do not read shell profiles. Their PATH is /usr/bin:/bin:/usr/sbin:/sbin, so
  node is called by its full path, and its folder and ~/.local/bin are added to PATH here: the
  build needs `kirocrew` and `kiro-cli`, which live in ~/.local/bin.

  macOS's own folders stay FIRST on that PATH. This job runs outside every sandbox, with the
  Bee and GitHub logins in reach, so a program it starts by name (`git`, say) must be the
  system's own, never a file of the same name that turned up in a folder under the home folder.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.overnight.build</string>

  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__REPO__/packages/cli/src/main.ts</string>
    <string>build</string>
    <string>--if-due</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin:__NODE_DIR__:__HOME__/.local/bin</string>
    <key>HOME</key>
    <string>__HOME__</string>
  </dict>

  <!--
    macOS starts this job every 60 seconds, and once when it is loaded (at login, and when it is
    installed). macOS does not decide when a build happens. Overnight's own clock does, from its
    TZ and BUILD_TIME settings: the if-due switch above makes every start ask that clock first.
    The answer is "not yet" all day but once, and then the job ends within a second or two.

    macOS's calendar (a set hour and minute) is not used. It goes by the Mac's own time zone, not
    Overnight's, and it ran this job an hour late on Oct 11.

    If the Mac is asleep or switched off at BUILD_TIME, the first start after it is awake again
    finds the build still due and runs it then. A day's build is started at most once: the start
    is written down before the work begins. macOS starts no second copy of a job that is still
    running, so a long build is not disturbed by the next minute.
  -->
  <key>StartInterval</key>
  <integer>60</integer>

  <!-- Also once when it is loaded, so the first look at the clock does not wait a minute. -->
  <key>RunAtLoad</key>
  <true/>

  <!--
    When macOS stops the job (uninstall, restart, logout) it asks first, and ends it by force only
    if it is still there after this many seconds. `overnight build` answers the request: it has
    the builder stop what is running (a Kiro Crew job is removed, a cut-off build is recorded as
    interrupted), which takes about 10 seconds, and gives up waiting for that after 20.
  -->
  <key>ExitTimeOut</key>
  <integer>60</integer>

  <!--
    The build writes its own log, logs/build.log. This second file holds the one summary line it
    prints each night, and anything printed outside that log: a crash, or a bad setting that
    stopped it before it could start. A look at the clock that finds nothing due prints nothing.
  -->
  <key>StandardOutPath</key>
  <string>__DATA_DIR__/logs/build.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__DATA_DIR__/logs/build.launchd.log</string>
</dict>
</plist>
