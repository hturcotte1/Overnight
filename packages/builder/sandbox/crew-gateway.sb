;; Overnight: the macOS sandbox the whole Kiro Crew gateway runs in when BUILD_SANDBOX is
;; "overnight". Every job the gateway starts (the nightly probe, each build agent) inherits it.
;; In that mode the builder also runs its own `kirocrew cron ...` commands inside this profile.
;;
;; Used by the background job com.overnight.crew (see launchd/com.overnight.crew.plist.template;
;; scripts/install-agents.sh writes the command and reads the -D names out of this file):
;;   /usr/bin/sandbox-exec -f crew-gateway.sb \
;;       -D HOME=<home folder> -D DATA_DIR=<Overnight's data folder> -D REPO=<this repo> \
;;       -D NODE_DIR=<the Node.js install: the folder that holds bin/node> \
;;       -D NPM_CACHE=<npm's cache folder, ~/.npm> \
;;       -D KIRO_HOME=<Kiro's own folder, ~/.kiro> -D CREW_HOME=<Kiro Crew's own folder, ~/.kiro/crew> \
;;       <kirocrew> gateway --no-open --no-tunnel
;; Every value must be a full REAL path (no symbolic links in it, no "/" at the end): the sandbox
;; compares real paths, so a rule written with a linked path would match nothing. A missing value
;; makes sandbox-exec refuse to start anything, which is the safe way to fail.
;; A profile of ours may only ask for these names: HOME, DATA_DIR, REPO, NODE_DIR, NPM_CACHE,
;; KIRO_HOME, CREW_HOME, TMPDIR. The installer and packages/builder fill exactly those.
;;
;; What it is: a fence, not a sealed box. The network stays open (the model service, the npm
;; registry) and the operating system's own files stay readable. Everything a person keeps on
;; this Mac is closed unless it is on a short list:
;;   - READING and RUNNING are refused everywhere in the home folder, Overnight's data folder,
;;     this repo, the Node.js install, other disks, the folder shared between accounts and the
;;     shared temporary folders. Section 3 is the list of what a build may read and run all the
;;     same, each entry with its reason.
;;   - WRITING is refused in all of those places and where programs are installed, except the
;;     shorter list in section 5. A job must not be able to change anything that is later run,
;;     or read as a setting, outside this sandbox.
;;   - Other programs cannot be listed, looked at or signalled, and their command lines cannot be
;;     read (some programs are handed private text that way; Overnight's own detector no longer
;;     is: since Oct 10 its prompt goes in on standard input).
;;   - Starting other apps, creating background jobs, the Keychain, the clipboard, the
;;     preferences service and the ssh agent are refused.
;;   - Other programs' socket files are refused, all but the system's name service and those in
;;     the folders a job may write. So is the port of Overnight's own dashboard (section 11).
;;
;; Still reachable from a job, by design or because it cannot be helped:
;;   - the network, and every port on this Mac but the dashboard's;
;;   - the list of running programs, names and numbers only, never command lines (the rule that
;;     hides it also refuses a job's own process group, which Kiro Crew asks for: measured Oct 11);
;;   - Kiro CLI's own sign-in store, and Kiro Crew's own private files (one sandbox cannot tell
;;     the gateway from the agent it starts);
;;   - every build workspace (one profile covers every job, so a job can read and write another
;;     idea's workspace), and the build jobs' own temporary folder;
;;   - the NAMES of what is directly inside the home folder, /Users, ~/.kiro, ~/workplace,
;;     ~/.local and the Node.js folder: Kiro Crew will not start an agent unless it can open
;;     those folders (section 3 says why). Nothing behind the names: not ~/Documents, not
;;     ~/Library, not ~/.claude, not a single file that lies in the home folder itself;
;;   - macOS's own files outside the home folder (/Applications, /Library, /System, /usr,
;;     /private/etc ...).
;; That is why a brief only ever holds our own words plus a cleaned title and pitch, and why the
;; builder runs its probe before each night.
;;
;; Rule order matters: when two rules match, the LATER one wins.
(version 1)
(allow default)

(define home (param "HOME"))
(define data-dir (param "DATA_DIR"))
(define repo (param "REPO"))
(define node-dir (param "NODE_DIR"))
(define npm-cache (param "NPM_CACHE"))
(define kiro-home (param "KIRO_HOME"))
(define crew-home (param "CREW_HOME"))
(define (home-path rel) (string-append home rel))
(define (data-path rel) (string-append data-dir rel))
(define (node-path rel) (string-append node-dir rel))
(define (kiro-path rel) (string-append kiro-home rel))
(define (npm-path rel) (string-append npm-cache rel))
;; The build jobs' own temporary folder. The gateway's background job and the builder's own
;; commands are given it as TMPDIR. (Not the account's usual temporary folder: that one is shared
;; with every other program of this user and stays closed.)
(define build-tmp (data-path "/tmp/build"))
;; Everything inside a folder, but not the folder itself. A rule made with (subpath ...) also
;; covers the folder's own name, and a job that may write THAT can move the whole folder away
;; and put something else in its place. Rules follow names, not files.
(define (below dir) (regex (string-append "^" (regex-quote dir) "/")))
;; Lets a folder be reached without the folders above it being opened: each folder on the way
;; may be looked at (its name and kind), not listed or read. Node, Python and the shell all look
;; at every folder on the way to a file before they will open or run it.
(define (allow-traverse path)
  (let loop ((i 1))
    (if (< i (string-length path))
        (begin
          (if (char=? (string-ref path i) #\/)
              (allow file-read-metadata (literal (substring path 0 i))))
          (loop (+ i 1))))))
;; Lets every folder ABOVE a folder be opened. Opening a folder also lets the NAMES of what is
;; directly inside it be listed (the sandbox cannot tell the two apart); nothing inside can be
;; looked at, opened or run because of it. Needed for Kiro Crew only: see section 3.
(define (allow-open-above path)
  (let loop ((i 1))
    (if (< i (string-length path))
        (begin
          (if (char=? (string-ref path i) #\/)
              (allow file-read-data file-read-metadata (literal (substring path 0 i))))
          (loop (+ i 1))))))

;; 1. Ways out of the sandbox, and ways to reach other programs.
;;    Starting or scripting other apps (they would run outside it), creating background jobs:
(deny lsopen)
(deny appleevent-send)
(deny job-creation)
;;    launchctl: macOS itself refuses a sandboxed program that asks it to stop, kill, restart or
;;    unload a background job, but it does accept "disable" (tried on a throwaway job), which
;;    would keep the listener from starting again after the next login. A copy of the program
;;    is killed by macOS when it starts, so refusing the one real path is enough for the tool.
(deny process-exec* (literal "/bin/launchctl"))
;;    Signals: only to what the gateway started itself. Nothing may stop, freeze or kill another
;;    program of this user (the listener, the program watching a build). The one-line form
;;    (deny signal (target others)) loads on this macOS but does not stop anything.
(deny signal)
(allow signal (target same-sandbox))
;;    Other programs cannot be looked at either. All four rules are needed: the first two stop
;;    asking macOS about another process, the third stops reading its command line directly
;;    (the exact name "kern.procargs2" alone does not: the rule has to be the prefix), and the
;;    last stops `pgrep` and `top`, which get command lines from a system service instead.
;;    What the gateway started itself (same sandbox) can still be looked at and signalled.
(deny process-info*)
(allow process-info* (target same-sandbox))
(deny sysctl-read (sysctl-name-prefix "kern.procargs"))
(deny mach-lookup (global-name "com.apple.sysmond"))

;; 2. Reading and running: nothing in the home folder, Overnight's data folder, this repo, the
;;    Node.js install, other disks, the folder shared between accounts or the shared temporary
;;    folders. (A file that may not be read can still be RUN unless that is refused too.)
(deny file-read* process-exec*
  (subpath home)
  (subpath data-dir)
  (subpath (home-path "/.overnight"))
  (subpath repo)
  (subpath node-dir)
  (subpath "/Volumes")
  (subpath "/Users/Shared")
  (subpath "/private/tmp")
  (subpath "/private/var/tmp")
  (subpath "/private/var/folders"))
;;    The list of this Mac's accounts (opened again below, for Kiro Crew: see the end of section 3):
(deny file-read* (literal "/Users"))

;; 3. ... except what a build needs. A real gateway start, probe and agent build (Oct 10) ran with
;;    exactly this list; the entries that were tried without say so.
(allow file-read* process-exec*
  ;; Kiro's own folder: Kiro CLI's settings (the "do not share my content" switches) and saved
  ;; sessions, the agent files Kiro Crew gives Kiro CLI, and Kiro Crew's own folder with the
  ;; installed build skill and the job records.
  (subpath kiro-home)
  (subpath crew-home)
  ;; Kiro Crew's program: a Python environment, the Python it runs on, and the link between them.
  (subpath (home-path "/.kiro/crew-venv"))
  (literal (home-path "/.kiro/crew-venv-current"))
  (subpath (home-path "/.kiro/crew-python"))
  ;; A folder Kiro Crew checks at every start (it stops with an error when it may not look at
  ;; it). Always under the home folder, wherever Kiro's own folder is.
  (subpath (home-path "/.kiro/crew-auth-staging"))
  ;; Kiro CLI's settings at their usual place: Kiro CLI reads them there even when it is given
  ;; another folder of its own (KIRO_HOME).
  (subpath (home-path "/.kiro/settings"))
  ;; The folder kirocrew and kiro-cli are started from: the folder itself (the PATH names it) and,
  ;; by name, the links Kiro CLI and Kiro Crew put there to their own programs (a link has to be
  ;; readable itself, or the shell does not find the program: tried). Nothing else that is, or
  ;; will be, installed in that folder: the GitHub program is, on this Mac.
  (literal (home-path "/.local/bin"))
  (literal (home-path "/.local/bin/kirocrew"))
  (literal (home-path "/.local/bin/kiro-cli"))
  (literal (home-path "/.local/bin/kiro-cli-chat"))
  (literal (home-path "/.local/bin/kiro-cli-term"))
  (literal (home-path "/.local/bin/python3.12"))
  ;; The link ~/.local/node, which the PATH names.
  (literal (home-path "/.local/node"))
  ;; Of the Node.js install only node, npm and npx: tools installed "globally" live in the same
  ;; folder (the Bee program does on this Mac, with its command in Node's own bin folder).
  (literal (node-path "/bin/node"))
  (literal (node-path "/bin/npm"))
  (literal (node-path "/bin/npx"))
  (subpath (node-path "/lib/node_modules/npm"))
  (subpath (node-path "/lib/node_modules/corepack"))
  (subpath (node-path "/include"))
  ;; Of npm's cache only the package store and npm's own "last checked" note. Not npm's logs,
  ;; which name other projects on this Mac (they can be written, see below and section 5, never
  ;; listed or read).
  (subpath (npm-path "/_cacache"))
  (literal (npm-path "/_update-notifier-last-checked"))
  ;; Kiro CLI's sign-in store and its own data.
  (subpath (home-path "/Library/Application Support/kiro-cli"))
  ;; The browser the app's own smoke test runs in.
  (subpath (home-path "/Library/Caches/ms-playwright"))
  ;; The folder Kiro Crew makes a folder in for each run.
  (subpath (home-path "/workplace/kirocrew-workspace")))
;;    npm's logs: npm looks for its log file by name before it makes it, and gives up on a
;;    refusal. So a name in that folder may be looked at (is it there, how big), which is all:
;;    the folder cannot be listed and no log can be opened.
(allow file-read-metadata (subpath (npm-path "/_logs")))
;;    The folders on the way to those: looked at, never listed.
(allow-traverse kiro-home)
(allow-traverse crew-home)
(allow-traverse (home-path "/.kiro/crew-venv"))
(allow-traverse (home-path "/.local/bin"))
(allow-traverse (node-path "/bin/node"))
(allow-traverse (node-path "/lib/node_modules/npm"))
(allow-traverse (node-path "/include"))
(allow-traverse (npm-path "/_cacache"))
(allow-traverse (home-path "/Library/Application Support/kiro-cli"))
(allow-traverse (home-path "/Library/Caches/ms-playwright"))
(allow-traverse (home-path "/workplace/kirocrew-workspace"))
;;    Kiro Crew 0.8.0 will not start an agent unless it can OPEN, one by one, every folder above
;;    its own folder and above the folder it runs the agent in (it compares them to make sure the
;;    two are apart; with one of them closed the job fails at once: "cannot verify that macOS
;;    agent workspace ... a filesystem check failed on '..'"). It also drops from the agent's PATH
;;    every folder it cannot open, or that has a closed folder above it, and node, npm and
;;    kiro-cli are found through the PATH. So these folders, and no others, can be opened: the
;;    home folder itself, /Users, ~/.kiro, ~/workplace, ~/.local, the Node.js folder and its bin
;;    folder. That lets a job list the NAMES directly inside each of them. It cannot look at, open
;;    or run what the names stand for (~/Documents, ~/Desktop, ~/Library, ~/.claude ... stay
;;    closed), unless it is on the list above.
(allow-open-above crew-home)
(allow-open-above (home-path "/workplace/kirocrew-workspace"))
(allow-open-above (home-path "/.local/bin"))
(allow-open-above (node-path "/bin/node"))

;; 4. Writing: nowhere in the home folder, Overnight's data folder, this repo, the places
;;    programs are installed in, other disks, or the shared temporary folders ...
(deny file-write*
  (subpath home)
  (subpath data-dir)
  (subpath (home-path "/.overnight"))
  (subpath repo)
  (subpath node-dir)
  (subpath "/Applications")
  (subpath "/Library")
  (subpath "/opt")
  (subpath "/usr/local")
  (subpath "/Users/Shared")
  (subpath "/Volumes")
  (subpath "/private/tmp")
  (subpath "/private/var/tmp")
  (subpath "/private/var/folders"))

;; 5. ... except what a build needs.
(allow file-write*
  ;; Kiro Crew's own state: its home, the folder it checks at start-up, and the folder it makes
  ;; for each run
  (below crew-home)
  (subpath (home-path "/.kiro/crew-auth-staging"))
  (subpath (home-path "/workplace/kirocrew-workspace"))
  ;; The agent files Kiro Crew refreshes at every start: only its own, whose names all begin
  ;; with "kirocrew" or ".kirocrew", and the temporary file it writes each one through before
  ;; renaming it into place ("tmp" + 8 characters + ".tmp", Python's mkstemp). Kiro CLI loads
  ;; the .json files in this folder as agents, so a job must not be able to add one of its own
  ;; under another name.
  (regex (string-append "^" (regex-quote (kiro-path "/agents")) "/\\.?kirocrew[^/]*(/|$)"))
  (regex (string-append "^" (regex-quote (kiro-path "/agents")) "/tmp[a-z0-9_]+\\.tmp$"))
  ;; Kiro CLI's own: saved sessions, and its sign-in store
  (below (kiro-path "/sessions"))
  (below (home-path "/Library/Application Support/kiro-cli"))
  ;; npm's download cache and its logs (not ~/.npm/_npx: packages kept there are run later
  ;; without being checked)
  (subpath (npm-path "/_cacache"))
  (subpath (npm-path "/_logs"))
  (literal (npm-path "/_update-notifier-last-checked")))
;;    Kiro Crew makes its own home private (chmod 700) every time it starts. That one change to
;;    the folder itself is allowed; moving or replacing the folder is not.
(allow file-write-mode
  (literal crew-home))

;; 6. Logins: no reading, no running, no writing, whatever sections 3 and 5 say now or are
;;    changed to say later.
(deny file-read* file-write* process-exec*
  (subpath (home-path "/.ssh"))
  (subpath (home-path "/.aws"))
  (subpath (home-path "/.config/gh"))
  (subpath (home-path "/Library/Keychains"))
  (literal (string-append repo "/.env"))
  ;; the same folders and files Kiro Crew's own "strict" level hides, which is switched off here.
  ;; Left out on purpose: ~/.kiro/crew-auth-staging (hiding it crashed the gateway at start-up in
  ;; the experiment), and ~/.kiro/crew/.vault and ~/.kiro/crew/.env (the gateway's own).
  (subpath (home-path "/.gnupg"))
  (subpath (home-path "/.gpg"))
  (subpath (home-path "/.config/gcloud"))
  (subpath (home-path "/.azure"))
  (subpath (home-path "/.docker"))
  (subpath (home-path "/.kube"))
  (literal (home-path "/.npmrc"))
  (literal (home-path "/.pypirc"))
  (literal (home-path "/.netrc"))
  (literal (home-path "/.git-credentials"))
  ;; the GitHub program, the one program that could publish, and what it keeps (section 3 does
  ;; not open them; named so that it never does)
  (literal (home-path "/.local/bin/gh"))
  (subpath (home-path "/.local/state")))

;; 7. Never writable, whatever section 5 says now or is changed to say later: where programs are
;;    run from, and where settings are read from, OUTSIDE this sandbox.
(deny file-write*
  ;; node, kirocrew, kiro-cli and gh
  (subpath (home-path "/.local"))
  (subpath node-dir)
  (subpath "/Applications")
  ;; Kiro Crew's own program files (kirocrew is a link into crew-venv)
  (subpath (home-path "/.kiro/crew-venv"))
  (literal (home-path "/.kiro/crew-venv-current"))
  (subpath (home-path "/.kiro/crew-python"))
  ;; Kiro's settings (the "do not share my content" switches), and the files Kiro CLI gives to
  ;; shells to load
  (subpath (home-path "/.kiro/settings"))
  (subpath (kiro-path "/settings"))
  (subpath (home-path "/Library/Application Support/kiro-cli/shell"))
  ;; this repo: the `overnight` tool itself
  (subpath repo)
  ;; background jobs
  (subpath (home-path "/Library/LaunchAgents"))
  ;; what shells and git read when they start
  (literal (home-path "/.zshenv"))
  (literal (home-path "/.zshrc"))
  (literal (home-path "/.zprofile"))
  (literal (home-path "/.zlogin"))
  (literal (home-path "/.zlogout"))
  (literal (home-path "/.bash_profile"))
  (literal (home-path "/.bashrc"))
  (literal (home-path "/.bash_login"))
  (literal (home-path "/.profile"))
  (literal (home-path "/.gitconfig"))
  (subpath (home-path "/.config")))

;; 8. Overnight's own data: what Bee heard and everything made from it (the database, the logs,
;;    the detector's Kiro sessions, briefs, reports, screenshots, the clone that is pushed to
;;    GitHub, the lock files). All of it is closed, for reading, running and writing, whatever the
;;    sections above say now or are changed to say later. The usual data folder is closed as well
;;    as the one in use: a gateway started against a test data folder must still not see the real
;;    transcripts.
(deny file-read* file-write* process-exec*
  (subpath (home-path "/.overnight"))
  (subpath data-dir))
;;    ... except the three folders a job works in: the build workspaces, the probe's results,
;;    and the build jobs' own temporary folder. Reading includes the folder itself; writing does
;;    not (see "below" above).
(allow file-read* process-exec*
  (subpath (data-path "/workspaces"))
  (subpath (data-path "/tmp/build-probe"))
  (subpath build-tmp))
(allow file-write*
  (below (data-path "/workspaces"))
  (below (data-path "/tmp/build-probe"))
  (below build-tmp))
;;    The folders on the way to them (the data folder, its tmp folder, and whatever is above):
;;    looked at, never listed.
(allow-traverse (data-path "/workspaces"))
(allow-traverse (data-path "/tmp/build-probe"))
(allow-traverse build-tmp)

;; 9. Claude Code's own files: the records of the sessions this project was written in, and
;;    their scratch folders, which have held test output with what Bee heard in it. Never
;;    readable, runnable or writable, whatever any rule above says.
(deny file-read* file-write* process-exec*
  (regex #"^/private/tmp/claude-[0-9]+(/|$)")
  (subpath (home-path "/.claude"))
  (literal (home-path "/.claude.json"))
  (literal (home-path "/.claude.json.backup"))
  (subpath (home-path "/Library/Application Support/Claude"))
  (subpath (home-path "/Library/Caches/claude-cli-nodejs")))

;; 10. System services a job has no business with.
(deny mach-lookup
  ;; the Keychain (GitHub's and Bee's logins live there). Kiro CLI does not need it: in the
  ;; experiment it signed in and ran a whole build with this rule in place.
  (global-name "com.apple.SecurityServer")
  (global-name "com.apple.securityd")
  ;; the clipboard
  (global-name "com.apple.pasteboard.1")
  ;; the preferences service: it writes files in ~/Library/Preferences on a program's behalf,
  ;; whatever the file rules above say
  (global-name "com.apple.cfprefsd.agent")
  (global-name "com.apple.cfprefsd.daemon"))

;; 11. Other programs' socket files, and Overnight's own dashboard.
;;     A socket file is opened with "connect", which none of the file rules above covers (found
;;     Oct 10). Whatever listens on one (a terminal that keeps sessions, a container tool, an
;;     editor, a password manager's helper) would be a way out of this fence. So every socket
;;     file is refused ...
(deny network-outbound (remote unix-socket (path-regex #"^/")))
;;     ... except the system's name service, without which no host name can be looked up (tried
;;     Oct 11: Node then answers ENOTFOUND for the npm registry), and socket files inside the
;;     folders a job may write anyway. Kiro Crew keeps its own in its home.
(allow network-outbound
  (remote unix-socket (path-literal "/private/var/run/mDNSResponder"))
  (remote unix-socket (path-regex (string-append "^" (regex-quote crew-home) "/")))
  (remote unix-socket (path-regex (string-append "^" (regex-quote build-tmp) "/")))
  (remote unix-socket (path-regex (string-append "^" (regex-quote (data-path "/workspaces")) "/")))
  (remote unix-socket (path-regex (string-append "^" (regex-quote (data-path "/tmp/build-probe")) "/")))
  (remote unix-socket (path-regex (string-append "^" (regex-quote (home-path "/workplace/kirocrew-workspace")) "/")))
  (remote unix-socket (path-regex (string-append "^" (regex-quote (home-path "/Library/Application Support/kiro-cli")) "/"))))
;;     The ssh agent: macOS gives every program its socket, and keys loaded in it could be used
;;     without ever reading ~/.ssh. Refused by name as well, after the list above, so that no
;;     entry added to that list can ever open it.
(deny network-outbound
  (remote unix-socket (path-regex #"^/private/var/run/com\.apple\.launchd\.[^/]+/Listeners$")))
;;     Overnight's dashboard shows what Bee heard. No job may read it, or take its port. (Every
;;     other port on this Mac stays open: the gateway's own has to, and a build serves its own
;;     preview on one.)
;;     The port is refused by its number alone, on every address ("*"), not on "localhost". A
;;     rule written with "localhost" does not cover this Mac's own address written the long way
;;     round, as an IPv6 one (::ffff:127.0.0.1). Measured Oct 11: by that spelling a job read a
;;     page served on 127.0.0.1, and with the page gone it took the port and served its own.
;;     The price: a job cannot reach port 4321 on any other machine either. No build needs to.
(deny network-outbound (remote ip "*:4321"))
(deny network-bind (local ip "*:4321"))
