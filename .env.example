# Copy this file to `.env` and fill in the blanks. Never commit `.env`.

# Kiro key for the detector and the fallback builder (needs Kiro Pro). Never share it.
KIRO_API_KEY=

# Public GitHub repo that published apps go to (GitHub Pages turned on).
GITHUB_PAGES_REPO=overnight-apps

# Where Overnight keeps its data. Always outside this repo. Default: ~/.overnight
OVERNIGHT_DATA_DIR=

# Times are local to TZ, 24-hour clock.
TZ=America/Boise
ASK_CUTOFF=23:00
BUILD_TIME=01:00
DELIVER_TIME=07:00

MAX_ASKS_PER_DAY=3
MAX_BUILDS_PER_NIGHT=2
BUILD_TIMEOUT_MIN=45

WRITE_BEE_FACTS=true
PAUSED=false
